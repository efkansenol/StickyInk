<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Targets .NET Framework 4.8 on purpose: it ships with every Windows 10/11 install,
    so the built StickyInk.exe runs anywhere with no runtime to install.
    The language version is "latest", so modern C# syntax is fine.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>StickyInk</AssemblyName>
    <RootNamespace>StickyInk</RootNamespace>
    <Version>1.0.0</Version>
    <Product>StickyInk</Product>
    <Description>Draw on your screen. The ink scrolls with the page.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Always produce bin\StickyInk.exe, whatever the configuration. -->
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <!-- No StickyInk.exe.config next to the exe: the app is a single file. -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
